# Copy to .env (gitignored) and fill in. Read ONLY by server/dmProxy.mjs — never bundled into the browser.
XAI_API_KEY=
# Optional overrides
# XAI_MODEL=grok-4.3
# XAI_REASONING_EFFORT=none   # none|low|medium|high (leave empty to omit the param)
# DM_PROXY_PORT=5174
# XAI_TIMEOUT_MS=45000

# --- Groq Cloud (alternative backend, OpenAI-compatible) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant   # or llama-3.3-70b-versatile for better prose
# GROQ_TIMEOUT_MS=45000
# Recommended: set explicitly. Default when unset: groq if GROQ_API_KEY set (even if XAI_API_KEY also set), else xai, else stub.
# No automatic fallback to the paid backend if Groq fails.
DM_PROVIDER=groq
